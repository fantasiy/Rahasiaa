    <script>
        // ============================================================
        //  1.  STARS
        // ============================================================
        (function createStars() {
            const container = document.getElementById('stars');
            const count = 180;
            for (let i = 0; i < count; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                const size = 1.5 + Math.random() * 3.5;
                star.style.width = size + 'px';
                star.style.height = size + 'px';
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.setProperty('--d', (2 + Math.random() * 4) + 's');
                star.style.animationDelay = (Math.random() * 6) + 's';
                container.appendChild(star);
            }
        })();

        // ============================================================
        //  2.  FLOATING HEARTS
        // ============================================================
        (function createHearts() {
            const container = document.getElementById('floatingHearts');
            const emojis = ['❤️', '💖', '💗', '♥️', '💕', '🌸', '✨'];
            for (let i = 0; i < 14; i++) {
                const el = document.createElement('div');
                el.className = 'heart-float';
                el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                el.style.left = Math.random() * 95 + '%';
                el.style.fontSize = (1.2 + Math.random() * 1.8) + 'rem';
                el.style.animationDuration = (12 + Math.random() * 18) + 's';
                el.style.animationDelay = (Math.random() * 20) + 's';
                el.style.opacity = 0.3 + Math.random() * 0.4;
                container.appendChild(el);
            }
        })();

        // ============================================================
        //  3.  TYPING EFFECT (Slide 1)
        // ============================================================
        (function typeEffect() {
            const titleEl = document.getElementById('typingTitle');
            const subEl = document.getElementById('typingSub');
            const fullTitle = 'Halo, Haliza Cahyati Ramadhan.';
            const fullSub = 'Ini Bayu Andriyan. Hari Girlfriend Nasional itu tanggal 1 Agustus. Sekarang sudah lewat seminggu.';

            let idxTitle = 0,
                idxSub = 0;
            let isTitleDone = false;

            function typeTitle() {
                if (idxTitle < fullTitle.length) {
                    titleEl.innerHTML = fullTitle.slice(0, idxTitle + 1) + '<span class="typing-cursor"></span>';
                    idxTitle++;
                    setTimeout(typeTitle, 65);
                } else {
                    titleEl.innerHTML = fullTitle;
                    isTitleDone = true;
                    // mulai sub setelah jeda
                    setTimeout(typeSub, 400);
                }
            }

            function typeSub() {
                if (idxSub < fullSub.length) {
                    subEl.innerHTML = fullSub.slice(0, idxSub + 1) + '<span class="typing-cursor"></span>';
                    idxSub++;
                    setTimeout(typeSub, 45);
                } else {
                    subEl.innerHTML = fullSub;
                }
            }

            // Mulai setelah slide aktif
            setTimeout(typeTitle, 600);
        })();

        // ============================================================
        //  4.  SLIDER NAVIGATION
        // ============================================================
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');

        function nextSlide() {
            if (currentSlide < slides.length - 1) {
                slides[currentSlide].classList.remove('active');
                currentSlide++;
                slides[currentSlide].classList.add('active');

                // Jika slide ke-5 (indeks 4) muncul, trigger confetti
                if (currentSlide === 4) {
                    launchConfetti();
                }
            }
        }

        // ============================================================
        //  5.  SCRATCH CARD
        // ============================================================
        const canvas = document.getElementById('scratchCanvas');
        const ctx = canvas.getContext('2d');
        let isDrawing = false;

        // Sesuaikan ukuran canvas dengan CSS
        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width || 340;
            canvas.height = rect.height || 160;
            // isi ulang layer abu-abu
            ctx.fillStyle = '#2a2a3e';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.font = 'bold 18px Segoe UI';
            ctx.fillStyle = '#ff4d6d';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('✦ GOSOK ✦', canvas.width / 2, canvas.height / 2);
            ctx.font = '13px Segoe UI';
            ctx.fillStyle = '#aaa';
            ctx.fillText('pakai jari atau kursor', canvas.width / 2, canvas.height / 2 + 30);
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        function getPos(evt) {
            const rect = canvas.getBoundingClientRect();
            let cx = evt.clientX,
                cy = evt.clientY;
            if (evt.touches && evt.touches.length > 0) {
                cx = evt.touches[0].clientX;
                cy = evt.touches[0].clientY;
            }
            return {
                x: (cx - rect.left) * (canvas.width / rect.width),
                y: (cy - rect.top) * (canvas.height / rect.height)
            };
        }

        function scratch(x, y) {
            ctx.globalCompositeOperation = 'destination-out';
            ctx.beginPath();
            ctx.arc(x, y, 22, 0, Math.PI * 2);
            ctx.fill();
        }

        canvas.addEventListener('mousedown', (e) => { isDrawing = true;
            const p = getPos(e);
            scratch(p.x, p.y); });
        canvas.addEventListener('mousemove', (e) => { if (isDrawing) { const p = getPos(e);
                scratch(p.x, p.y); } });
        canvas.addEventListener('mouseup', () => { isDrawing = false; });
        canvas.addEventListener('mouseleave', () => { isDrawing = false; });

        canvas.addEventListener('touchstart', (e) => { isDrawing = true;
            const p = getPos(e);
            scratch(p.x, p.y);
            e.preventDefault(); }, { passive: false });
        canvas.addEventListener('touchmove', (e) => { if (isDrawing) { const p = getPos(e);
                scratch(p.x, p.y);
                e.preventDefault(); } }, { passive: false });
        canvas.addEventListener('touchend', () => { isDrawing = false; });

        // ============================================================
        //  6.  TOMBOL "TIDAK" MENGHINDAR
        // ============================================================
        function dodge() {
            const btn = document.getElementById('btnNo');
            const container = btn.parentElement;
            const rect = container.getBoundingClientRect();
            const bw = btn.offsetWidth,
                bh = btn.offsetHeight;
            const maxX = rect.width - bw - 10;
            const maxY = rect.height - bh - 10;
            const x = Math.random() * maxX;
            const y = Math.random() * maxY;
            btn.style.position = 'relative';
            btn.style.left = x + 'px';
            btn.style.top = y + 'px';
            // sedikit efek getar
            btn.style.transition = 'left 0.25s ease, top 0.25s ease';
        }

        // ============================================================
        //  7.  TOMBOL "YA" - CONFETTI + ALERT
        // ============================================================
        function handleYes() {
            launchConfetti(60);
            alert('Keputusan yang logis. Terima kasih, Haliza. ❤️');
        }

        // ============================================================
        //  8.  CONFETTI (kembang api mini)
        // ============================================================
        function launchConfetti(count = 70) {
            const colors = ['#ff4d6d', '#ff8c9e', '#ffb3b3', '#ffd6e0', '#ff6f91', '#ff3b5c', '#ffb8c6'];
            for (let i = 0; i < count; i++) {
                const el = document.createElement('div');
                el.className = 'confetti-piece';
                const size = 6 + Math.random() * 10;
                el.style.width = size + 'px';
                el.style.height = size + 'px';
                el.style.background = colors[Math.floor(Math.random() * colors.length)];
                el.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                el.style.left = (Math.random() * 100) + '%';
                el.style.top = '-10px';
                el.style.animationDuration = (2.5 + Math.random() * 3) + 's';
                el.style.animationDelay = (Math.random() * 1.2) + 's';
                el.style.transform = `rotate(${Math.random() * 360}deg)`;
                el.style.boxShadow = `0 0 8px ${el.style.background}44`;
                document.body.appendChild(el);
                // hapus setelah animasi selesai
                setTimeout(() => el.remove(), 5000);
            }
        }

        // ============================================================
        //  9.  EFEK RIPPLE PADA SEMUA TOMBOL (opsional)
        // ============================================================
        document.querySelectorAll('button').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const rect = this.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const ripple = document.createElement('span');
                ripple.style.cssText = `
                            position: absolute;
                            width: 60px; height: 60px;
                            background: rgba(255,255,255,0.25);
                            border-radius: 50%;
                            left: ${x - 30}px;
                            top: ${y - 30}px;
                            transform: scale(0);
                            animation: rippleAnim 0.6s ease-out forwards;
                            pointer-events: none;
                        `;
                this.appendChild(ripple);
                setTimeout(() => ripple.remove(), 700);
            });
        });

        // Tambahkan keyframe untuk ripple (dinamis)
        const styleSheet = document.createElement('style');
        styleSheet.textContent = `
                    @keyframes rippleAnim {
                        to { transform: scale(4); opacity: 0; }
                    }
                `;
        document.head.appendChild(styleSheet);

        // ============================================================
        //  10. EFEK PARALLAX SAAT GERAKAN MOUSE (opsional)
        // ============================================================
        document.addEventListener('mousemove', (e) => {
            const x = e.clientX / window.innerWidth - 0.5;
            const y = e.clientY / window.innerHeight - 0.5;
            document.querySelector('.rays').style.transform =
                `translate(${x * 12}px, ${y * 8}px) rotate(${x * 8}deg)`;
            document.querySelector('.stars').style.transform =
                `translate(${x * 6}px, ${y * 4}px)`;
        });

        console.log('❤️ Untuk Haliza, dari Bayu — dengan segala keterlambatan dan ketulusan.');
    </script>
</body>
